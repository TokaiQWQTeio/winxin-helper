[Unit]
Description=WeChat assistant metadata relay (WireGuard only)
After=network-online.target wg-quick@wg-assistant.service
Wants=network-online.target
Requires=wg-quick@wg-assistant.service

[Service]
Type=simple
User=wechat-relay
Group=wechat-relay
WorkingDirectory=/opt/wechat-assistant-relay
EnvironmentFile=/etc/wechat-assistant-relay.env
Environment=ASSISTANT_RELAY_DB=/var/lib/wechat-assistant-relay/relay.db
ExecStart=/usr/bin/python3 -m remote.status_service
Restart=on-failure
RestartSec=5
StateDirectory=wechat-assistant-relay
StateDirectoryMode=0700
UMask=0077
MemoryMax=128M
CPUQuota=20%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
